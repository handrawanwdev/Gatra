// Dikompilasi sebagai ES Module. Visibility gaya Go: huruf awal besar =
// publik/terekspor, tidak perlu keyword 'ekspor'.

paket matematika

fungsi Tambah(a: angka, b: angka): angka {
  balik a + b
}

fungsi Kurang(a: angka, b: angka): angka {
  balik a - b
}

fungsi Kali(a: angka, b: angka): angka {
  balik a * b
}

fungsi Kuadrat(n: angka): angka {
  balik n * n
}
