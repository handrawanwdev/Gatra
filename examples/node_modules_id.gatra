// node_modules_id.gatra — Mengimpor modul bawaan Node.js (mode Indonesia)

impor crypto dari "crypto"
impor os     dari "os"
impor path   dari "path"
impor fs     dari "fs"

// ── crypto ────────────────────────────────────────────────────────────────────

isi hash = crypto.createHash("sha256").update("Bahasa Gatra").digest("hex")
cetak("SHA-256:", hash)

isi uuid = crypto.randomUUID()
cetak("UUID:", uuid)

// ── os ────────────────────────────────────────────────────────────────────────

isi platform = os.platform()
isi hostname = os.hostname()
isi home     = os.homedir()
isi jumlah_cpu = os.cpus().length

cetak("Platform:", platform)
cetak("Hostname:", hostname)
cetak("Direktori home:", home)
cetak("Jumlah CPU:", jumlah_cpu)

// ── path ──────────────────────────────────────────────────────────────────────

isi gabung  = path.join("/home", "user", "proyek", "main.gatra")
isi nama    = path.basename("/home/user/proyek/main.gatra")
isi ekstensi = path.extname("main.gatra")
isi folder  = path.dirname("/home/user/proyek/main.gatra")

cetak("Gabung:", gabung)
cetak("Nama file:", nama)
cetak("Ekstensi:", ekstensi)
cetak("Folder:", folder)

// ── fs ────────────────────────────────────────────────────────────────────────

isi ada = fs.existsSync("/etc/hostname")
cetak("File ada:", ada)
