// 17_konkurensi_terstruktur.gatra — tugas, jalankan { } tunggu, dan pilih

fungsi asinkron ambilPengguna(): tiada {
  cetak("pengguna diambil")
}

fungsi asinkron ambilPesanan(): tiada {
  cetak("pesanan diambil")
}

// 'jalankan { } tunggu' menjamin semua 'tugas' di dalamnya selesai
// sebelum kode setelahnya berjalan (concurrency terstruktur).
fungsi asinkron muatBeranda(): tiada {
  jalankan {
    tugas ambilPengguna()
    tugas ambilPesanan()
  } tunggu
  cetak("beranda siap ditampilkan")
}
muatBeranda()

// 'tugas' tanpa pembungkus 'jalankan { } tunggu' = fire-and-forget
fungsi asinkron catatLog(pesan: teks): tiada {
  cetak("log: " + pesan)
}
tugas catatLog("aplikasi dimulai")

// 'pilih' — menunggu beberapa 'saluran' sekaligus, jalankan yang lebih dulu siap
fungsi asinkron demoPilih(): tiada {
  isi s1 = saluran()
  isi s2 = saluran()
  s1.kirim("data dari s1")

  pilih {
    kasus s1 -> cetak("menerima dari s1")
    kasus s2 -> cetak("menerima dari s2")
  }
}
demoPilih()
