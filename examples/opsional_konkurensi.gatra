// opsional_konkurensi.gatra — Nilai opsional + kunci/saluran (PRD bagian 15, 19, 20)

fungsi cariPengguna(id: angka): teks? {
  jika (id == 1) {
    balik "Handrawan"
  }
  balik kosong
}

isi nama = cariPengguna(1)
jika (nama != kosong) {
  cetak("Ditemukan:")
  cetak(nama)
} lain {
  cetak("Pengguna tidak ditemukan")
}

isi tidakDitemukan = cariPengguna(99)
jika (tidakDitemukan == kosong) {
  cetak("Sesuai dugaan: tidak ditemukan")
}

// kunci — melindungi data yang digunakan bersama antar tugas asinkron
isi kunci = kunci()
isi ubah total: angka = 0

fungsi asinkron tambahkan(nilai: angka): tiada {
  tunggu kunci.kunci()
  total = total + nilai
  kunci.buka()
}

// saluran — memindahkan data antar tugas tanpa berbagi mutable state langsung
isi saluran = saluran()

fungsi asinkron produsen(): tiada {
  saluran.kirim(10)
  saluran.kirim(20)
}

fungsi asinkron konsumen(): tiada {
  isi a = tunggu saluran.terima()
  isi b = tunggu saluran.terima()
  cetak("Diterima dari saluran:")
  cetak(a)
  cetak(b)
}

produsen()
konsumen()
