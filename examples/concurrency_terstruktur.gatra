// concurrency_terstruktur.gatra — 'tugas' + 'jalankan { } tunggu' + 'pilih' (PRD bagian 17-23)

fungsi asinkron ambilA(): tiada {
  cetak("A selesai")
}

fungsi asinkron ambilB(): tiada {
  cetak("B selesai")
}

fungsi asinkron utama(): tiada {
  jalankan {
    tugas ambilA()
    tugas ambilB()
  } tunggu
  cetak("Keduanya selesai")

  isi s1 = saluran()
  isi s2 = saluran()
  s1.kirim("dari saluran 1")

  pilih {
    kasus s1 -> cetak("Menerima dari s1")
    kasus s2 -> cetak("Menerima dari s2")
  }
}

utama()
