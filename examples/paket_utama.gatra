// paket_utama.gatra — File utama yang mengimpor paket (mode Indonesia)

impor mat dari "./paket_matematika.gatra"

fungsi mulai(): tiada {
  isi jumlah = mat.Tambah(10, 5)
  cetak(jumlah)

  isi selisih = mat.Kurang(20, 8)
  cetak(selisih)

  isi hasil_kali = mat.Kali(4, 6)
  cetak(hasil_kali)

  isi kuadrat = mat.Kuadrat(7)
  cetak(kuadrat)
}

mulai()
